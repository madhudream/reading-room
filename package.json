{
  "name": "madhu-lms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A reading room: pull blogs into a learning list, read, quiz, recall every day, and talk to a reading assistant.",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "tunnel": "bash scripts/tunnel.sh",
    "deploy": "bash scripts/deploy.sh",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2"
  }
}
