# The Reading Room — copy to .env
OPEN_ROUTER_KEY=            # https://openrouter.ai (quizzes, grading, filtering, the assistant)
SESSION_SECRET=             # any long random string: openssl rand -hex 32
ADMIN_USERNAME=admin        # created at first start; ADMIN_PASSWORD changes are applied once on restart
ADMIN_PASSWORD=

# storage: leave TWINDB_URL empty to keep everything in .data/ (fine for one machine)
TWINDB_URL=                 # e.g. http://localhost:18093 through `bun run tunnel`
TWINDB_TOKEN=
LMS_BUCKET=                 # a GCS bucket for article bodies; empty = .data/blobs

# optional
# READING_EXPORT_TOKEN=     # lets a personal hours log read one reader's minutes (/api/export/reading)
# ALLOW_SIGNUP=true
# LINK_OUT_DOMAINS=outcomeschool.com
# AI_MODEL_FAST=qwen/qwen3.7-flash
# AI_MODEL_CHAT=anthropic/claude-sonnet-5
# PUBLIC_URL=https://reading.carebun.com
